# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-100123...
# FB_PAGE_ID=...
# FB_PAGE_TOKEN=...
# LINKEDIN_TOKEN=...
# LINKEDIN_AUTHOR_URN=urn:li:person:...
# BLUESKY_HANDLE=user.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# === Chatbot LLM (opsional) — set di Netlify UI: Site settings > Environment ===
# GEMINI_API_KEY=AIza...

# === Semantic embeddings (Level 1 AI SEO) ===
# Dipakai scripts/embed.py untuk hitung vektor artikel.
# Disimpan aman di ~/.config/openclaw/ai.env (jangan commit).
# SUMPOD_API_KEY=sk-xxx
# EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=https://ai.sumopod.com/v1

# === Facebook auto-post (System User, permanent) ===
# FB_PAGE_ID=1201993219661703
# FB_PAGE_TOKEN=***   # System User token (never expires)
# FB_PAGE_ACCESS_TOKEN=***  # optional cache; auto-derived from FB_PAGE_TOKEN if empty
