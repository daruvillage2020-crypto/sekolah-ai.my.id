---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import EventCard from "../components/EventCard.astro";
import { upcoming } from "../lib/events";

const features = [
  { title: "Kurikulum Terkurasi", desc: "Materi AI dari dasar hingga lanjutan, disusun praktisi." },
  { title: "Belajar Praktik", desc: "Proyek nyata dan studi kasus di setiap modul." },
  { title: "Komunitas Aktif", desc: "Bergabung dengan pelajar dan mentor dari seluruh Indonesia." },
];

const stats = [
  { value: "5.000+", label: "Pelajar" },
  { value: "120+", label: "Modul" },
  { value: "40+", label: "Mentor" },
  { value: "98%", label: "Kepuasan" },
];

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestPosts = allPosts.slice(0, 2);

const nextEvents = upcoming(await getCollection("events")).slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
---

<Layout title="Sekolah AI — Belajar Kecerdasan Buatan">
  <!-- Hero -->
  <section class="bg-gradient-to-b from-blue-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center">
      <span class="inline-block rounded-full bg-blue-100 px-4 py-1 text-sm font-medium text-brand">
        Ekosistem Belajar AI
      </span>
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
        Kuasai <span class="text-brand">Kecerdasan Buatan</span><br class="hidden sm:block" />
        bersama Sekolah AI
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
        Platform belajar AI yang mudah diakses, praktis, dan didukung komunitas
        yang berkembang. Mulai perjalananmu hari ini.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/produk" class="rounded-lg bg-brand px-6 py-3 font-medium text-white transition hover:bg-brand-dark">
          Lihat Produk
        </a>
        <a href="/tentang" class="rounded-lg border border-gray-300 px-6 py-3 font-medium text-gray-700 transition hover:bg-gray-50">
          Pelajari Lebih Lanjut
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 md:grid-cols-3">
      {features.map((f) => (
        <div class="rounded-xl border border-gray-200 p-6 transition hover:shadow-md">
          <div class="mb-4 grid h-12 w-12 place-items-center rounded-lg bg-blue-100 text-brand text-xl font-bold">✦</div>
          <h3 class="text-lg font-semibold text-gray-900">{f.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Agenda Terdekat -->
  {nextEvents.length > 0 && (
    <section class="bg-gray-50">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="mb-8 flex items-end justify-between">
          <div>
            <h2 class="text-3xl font-bold text-gray-900">📅 Agenda Terdekat</h2>
            <p class="mt-2 text-gray-600">Workshop, webinar, dan kegiatan seru lainnya</p>
          </div>
          <a href="/agenda" class="hidden text-sm font-medium text-brand transition hover:underline sm:block">
            Lihat semua agenda →
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {nextEvents.map((e) => <EventCard event={e} />)}
        </div>
        <div class="mt-8 text-center sm:hidden">
          <a href="/agenda" class="text-sm font-medium text-brand hover:underline">
            Lihat semua agenda →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Featured Blog Posts -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-8 flex items-end justify-between">
      <div>
        <h2 class="text-3xl font-bold text-gray-900">📝 Artikel Terbaru</h2>
        <p class="mt-2 text-gray-600">Baca wawasan AI terbaru dari Sekolah AI</p>
      </div>
      <a href="/blog" class="hidden text-sm font-medium text-brand transition hover:underline sm:block">
        Lihat semua artikel →
      </a>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {latestPosts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group relative flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:shadow-xl"
        >
          {post.data.cover ? (
            <div class="relative h-56 w-full overflow-hidden">
              <img
                src={post.data.cover}
                alt={post.data.title}
                class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent" />
            </div>
          ) : (
            <div class="flex h-56 w-full items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100">
              <span class="text-5xl">🧠</span>
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <time class="text-sm font-medium text-brand">{fmt(post.data.date)}</time>
            <h3 class="mt-2 text-xl font-bold text-gray-900 group-hover:text-brand line-clamp-2">
              {post.data.title}
            </h3>
            <p class="mt-2 line-clamp-2 text-sm text-gray-600">
              {post.data.description}
            </p>
            <div class="mt-4 flex items-center text-sm font-medium text-brand">
              Baca selengkapnya
              <svg class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-6 text-center sm:hidden">
      <a href="/blog" class="inline-block rounded-lg border border-gray-300 px-5 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50">
        Lihat semua artikel →
      </a>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-brand">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-12 md:grid-cols-4">
      {stats.map((s) => (
        <div class="text-center text-white">
          <div class="text-3xl font-bold">{s.value}</div>
          <div class="mt-1 text-sm text-blue-100">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 py-16 text-center">
    <h2 class="text-3xl font-bold text-gray-900">Siap mulai belajar AI?</h2>
    <p class="mx-auto mt-3 max-w-xl text-gray-600">
      Gabung komunitas dan temukan jalurmu di dunia kecerdasan buatan.
    </p>
    <a href="/kontak" class="mt-6 inline-block rounded-lg bg-brand px-6 py-3 font-medium text-white transition hover:bg-brand-dark">
      Hubungi Kami
    </a>
  </section>
</Layout>
