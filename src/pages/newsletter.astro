---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Newsletter — Sekolah AI"
  description="Dapatkan artikel AI terbaru langsung ke email kamu. Gratis, tanpa spam."
>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <div class="text-center">
      <span class="inline-block rounded-full bg-blue-100 px-4 py-1 text-sm font-medium text-brand">
        Newsletter
      </span>
      <h1 class="mt-6 text-4xl font-bold text-gray-900">
        Jangan lewatkan artikel AI terbaru
      </h1>
      <p class="mt-4 text-lg text-gray-600">
        Kami menerbitkan artikel baru setiap pagi dan sore. Dapatkan ringkasannya
        langsung ke email kamu — gratis, tanpa spam, bisa berhenti kapan saja.
      </p>
    </div>

    <form
      id="newsletter-form"
      name="newsletter"
      method="POST"
      action="/api/submit"
      class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm"
    >
      <input type="hidden" name="form-name" value="newsletter" />
      <p class="hidden">
        <label>Jangan diisi: <input name="bot-field" /></label>
      </p>

      <label class="block text-sm font-medium text-gray-700" for="name">Nama</label>
      <input
        id="name"
        name="name"
        type="text"
        required
        placeholder="Nama kamu"
        class="mt-1 w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:border-brand focus:outline-none"
      />

      <label class="mt-4 block text-sm font-medium text-gray-700" for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        required
        placeholder="nama@email.com"
        class="mt-1 w-full rounded-lg border border-gray-300 px-4 py-2.5 focus:border-brand focus:outline-none"
      />

      <button
        type="submit"
        class="mt-6 w-full rounded-lg bg-brand px-6 py-3 font-medium text-white transition hover:bg-brand-dark"
      >
        Berlangganan Gratis
      </button>
      <p id="newsletter-status" class="mt-3 hidden text-center text-sm"></p>
      <p class="mt-3 text-center text-xs text-gray-500">
        Kami hanya mengirim konten berkualitas. Bukan spam.
      </p>
    </form>

    <script>
      const nf = document.getElementById("newsletter-form");
      const ns = document.getElementById("newsletter-status");
      nf?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = nf.querySelector('button[type="submit"]');
        const orig = btn.textContent;
        btn.disabled = true;
        btn.textContent = "Mendaftarkan...";
        try {
          const res = await fetch(nf.action, { method: "POST", body: new FormData(nf) });
          const ok = res.ok && (await res.json()).ok;
          ns.className = ok
            ? "mt-3 text-center text-sm font-medium text-green-700"
            : "mt-3 text-center text-sm font-medium text-red-600";
          ns.textContent = ok
            ? "🎉 Berhasil! Cek inbox email kamu ya."
            : "❌ Gagal mendaftar. Coba lagi sebentar lagi.";
          if (ok) nf.reset();
        } catch {
          ns.className = "mt-3 text-center text-sm font-medium text-red-600";
          ns.textContent = "❌ Gagal mendaftar. Cek koneksi lalu coba lagi.";
        } finally {
          btn.disabled = false;
          btn.textContent = orig;
          ns.classList.remove("hidden");
        }
      });
    </script>

    <ul class="mt-8 grid gap-3 text-sm text-gray-600 sm:grid-cols-3">
      <li class="rounded-xl border border-gray-200 p-4">📬 2 artikel baru / hari</li>
      <li class="rounded-xl border border-gray-200 p-4">🎓 Tips &amp; tutorial AI</li>
      <li class="rounded-xl border border-gray-200 p-4">🔓 Gratis selamanya</li>
    </ul>

    <p class="mt-8 text-center text-sm text-gray-500">
      Sudah punya pertanyaan? Mampir ke <a href="/kontak" class="font-medium text-brand">halaman kontak</a>.
    </p>
  </section>
</Layout>