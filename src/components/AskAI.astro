---
// Floating "Tanya AI" assistant — grounded on site articles.
// Works fully client-side (no API key needed). Optionally upgrades to an
// LLM backend if window.__ASK_AI_ENDPOINT__ is configured.
---

<div id="ask-ai" class="ask-ai">
  <button id="ask-ai-toggle" class="ask-ai__fab" aria-label="Tanya AI">
    <span class="ask-ai__fab-icon">💬</span>
    <span class="ask-ai__fab-text">Tanya AI</span>
  </button>

  <div id="ask-ai-panel" class="ask-ai__panel" hidden>
    <div class="ask-ai__header">
      <div>
        <div class="ask-ai__title">Tanya AI</div>
        <div class="ask-ai__sub">Asisten Sekolah AI</div>
      </div>
      <button id="ask-ai-close" class="ask-ai__close" aria-label="Tutup">×</button>
    </div>

    <div id="ask-ai-messages" class="ask-ai__messages">
      <div class="ask-ai__msg ask-ai__msg--bot">
        Halo! 👋 Saya asisten Sekolah AI. Tanya apa saja soal AI, belajar, atau
        artikel di situs ini — nanti saya carikan jawabannya.
      </div>
    </div>

    <form id="ask-ai-form" class="ask-ai__form">
      <input
        id="ask-ai-input"
        class="ask-ai__input"
        type="text"
        placeholder="Tulis pertanyaanmu…"
        autocomplete="off"
      />
      <button type="submit" class="ask-ai__send">Kirim</button>
    </form>
  </div>
</div>

<style is:global>
  .ask-ai { position: fixed; right: 20px; bottom: 20px; z-index: 9999; font-family: inherit; }
  .ask-ai__fab {
    display: flex; align-items: center; gap: 8px;
    background: var(--color-brand, #2563eb); color: #fff;
    border: none; border-radius: 999px; padding: 12px 20px;
    font-size: 15px; font-weight: 600; cursor: pointer;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .ask-ai__fab:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(37,99,235,0.45); }
  .ask-ai__fab-icon { font-size: 18px; }
  .ask-ai__panel {
    position: absolute; right: 0; bottom: 64px;
    width: min(92vw, 380px); height: min(70vh, 520px);
    background: #fff; border: 1px solid #e5e7eb; border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.18);
    display: flex; flex-direction: column; overflow: hidden;
  }
  .ask-ai__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; background: var(--color-brand, #2563eb); color: #fff;
  }
  .ask-ai__title { font-weight: 700; font-size: 16px; }
  .ask-ai__sub { font-size: 12px; opacity: 0.85; }
  .ask-ai__close { background: none; border: none; color: #fff; font-size: 24px; line-height: 1; cursor: pointer; }
  .ask-ai__messages { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .ask-ai__msg {
    max-width: 88%; padding: 10px 13px; border-radius: 12px;
    font-size: 14px; line-height: 1.5; white-space: pre-wrap; word-wrap: break-word;
  }
  .ask-ai__msg--bot { background: #f1f5f9; color: #0f172a; align-self: flex-start; border-bottom-left-radius: 4px; }
  .ask-ai__msg--user { background: var(--color-brand, #2563eb); color: #fff; align-self: flex-end; border-bottom-right-radius: 4px; }
  .ask-ai__msg a { color: var(--color-brand, #2563eb); font-weight: 600; text-decoration: underline; }
  .ask-ai__msg--user a { color: #fff; }
  .ask-ai__links { margin-top: 8px; display: flex; flex-direction: column; gap: 6px; }
  .ask-ai__link {
    display: block; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px;
    padding: 8px 10px; font-size: 13px; text-decoration: none; color: #0f172a;
  }
  .ask-ai__link:hover { border-color: var(--color-brand, #2563eb); }
  .ask-ai__link b { color: var(--color-brand, #2563eb); }
  .ask-ai__form { display: flex; gap: 8px; padding: 12px; border-top: 1px solid #e5e7eb; }
  .ask-ai__input { flex: 1; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 12px; font-size: 14px; outline: none; }
  .ask-ai__input:focus { border-color: var(--color-brand, #2563eb); }
  .ask-ai__send {
    background: var(--color-brand, #2563eb); color: #fff; border: none;
    border-radius: 10px; padding: 0 16px; font-weight: 600; cursor: pointer; font-size: 14px;
  }
  .ask-ai__send:disabled { opacity: 0.5; cursor: default; }
  .ask-ai__typing { font-style: italic; opacity: 0.7; }
  @media (max-width: 480px) { .ask-ai__fab-text { display: none; } }
</style>

<script>
  (function () {
    const toggle = document.getElementById("ask-ai-toggle");
    const panel = document.getElementById("ask-ai-panel");
    const closeBtn = document.getElementById("ask-ai-close");
    const form = document.getElementById("ask-ai-form");
    const input = document.getElementById("ask-ai-input");
    const messages = document.getElementById("ask-ai-messages");

    if (!toggle || !panel) return;

    const STOP = new Set([
      "yang","dan","di","ke","dari","untuk","dengan","pada","adalah","ini","itu",
      "atau","juga","akan","bisa","dapat","tidak","dalam","sebagai","kita","anda",
      "apa","siapa","bagaimana","kenapa","mengapa","dimana","kapan","cara","adalah",
      "the","a","an","of","to","in","for","and","or","is","are","how","what","why",
    ]);

    const tokens = (s) =>
      s.toLowerCase().replace(/[^a-z0-9\u00c0-\u024f\s-]/gi, " ").split(/[\s-]+/)
        .filter((w) => w.length > 2 && !STOP.has(w));

    let index = [];
    let loaded = false;

    async function loadIndex() {
      if (loaded) return;
      try {
        const r = await fetch("/search-index.json");
        index = await r.json();
        loaded = true;
      } catch (e) { index = []; }
    }

    function score(qToks, doc) {
      const hay = `${doc.title} ${doc.title} ${doc.description} ${doc.text}`.toLowerCase();
      let s = 0;
      for (const t of qToks) {
        const qtf = hay.split(t).length - 1;
        if (qtf > 0) s += Math.log(1 + qtf) * (doc.title.toLowerCase().includes(t) ? 3 : 1);
      }
      return s;
    }

    function snippet(doc, qToks) {
      const text = doc.text || doc.description || "";
      const lower = text.toLowerCase();
      for (const t of qToks) {
        const i = lower.indexOf(t);
        if (i >= 0) {
          const start = Math.max(0, i - 60);
          return (start > 0 ? "…" : "") + text.slice(start, i + 160).trim() + "…";
        }
      }
      return (doc.description || text).slice(0, 200);
    }

    function addMsg(html, cls) {
      const div = document.createElement("div");
      div.className = `ask-ai__msg ask-ai__msg--${cls}`;
      div.innerHTML = html;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
      return div;
    }

    async function answer(q) {
      await loadIndex();
      const qToks = tokens(q);
      if (qToks.length === 0) {
        addMsg("Coba tulis pertanyaan yang lebih spesifik ya 🙂", "bot");
        return;
      }

      // Optional LLM backend upgrade (if configured via window.__ASK_AI_ENDPOINT__)
      const endpoint = window.__ASK_AI_ENDPOINT__;
      const ranked = index.map((d) => ({ d, s: score(qToks, d) })).sort((a, b) => b.s - a.s);
      const top = ranked.filter((r) => r.s > 0).slice(0, 3);

      if (top.length === 0) {
        addMsg(
          "Maaf, saya belum menemukan artikel yang cocok. Coba kata kunci lain, atau lihat daftar artikel di <a href='/blog'>Blog</a>.",
          "bot"
        );
        return;
      }

      if (endpoint) {
        try {
          const ctx = top.map((t) => `### ${t.d.title}\n${t.d.text}`).join("\n\n");
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ question: q, context: ctx }),
          });
          const data = await res.json();
          if (data.answer) {
            addMsg(data.answer.replace(/\n/g, "<br>"), "bot");
            return;
          }
        } catch (e) { /* fall through to local answer */ }
      }

      const best = top[0].d;
      let html = `<b>${best.title}</b><br>${snippet(best, qToks)}`;
      const links = top
        .map((t) => `<a class="ask-ai__link" href="${t.d.url}"><b>${t.d.title}</b></a>`)
        .join("");
      html += `<div class="ask-ai__links">${links}</div>`;
      addMsg(html, "bot");
    }

    toggle.addEventListener("click", () => {
      panel.hidden = !panel.hidden;
      if (!panel.hidden) { loadIndex(); input.focus(); }
    });
    closeBtn.addEventListener("click", () => (panel.hidden = true));

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      addMsg(q.replace(/</g, "&lt;"), "user");
      input.value = "";
      const typing = addMsg('<span class="ask-ai__typing">Mencari…</span>', "bot");
      answer(q).finally(() => typing.remove());
    });
  })();
</script>