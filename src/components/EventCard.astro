---
import {
  eventStatus,
  STATUS_LABEL,
  TYPE_LABEL,
  MODE_LABEL,
  fmtDateShort,
  type EventEntry,
} from "../lib/events";

interface Props {
  event: EventEntry;
}
const { event } = Astro.props;
const d = event.data;

const status = eventStatus(event);
const statusClass = {
  dibuka: "bg-green-100 text-green-800",
  berlangsung: "bg-amber-100 text-amber-800",
  selesai: "bg-gray-200 text-gray-600",
  ditutup: "bg-red-100 text-red-700",
}[status];

const modeIcon = { online: "💻", offline: "📍", hybrid: "🔀" }[d.mode] ?? "📌";
---

<a
  href={`/agenda/${event.id}/`}
  class="group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-shadow hover:shadow-lg"
>
  <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-brand/15 to-brand/5">
    {d.cover ? (
      <img
        src={d.cover}
        alt={d.title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full items-center justify-center text-5xl">
        {modeIcon}
      </div>
    )}
    <div class="absolute left-3 top-3 flex flex-wrap gap-2">
      <span class="rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-brand shadow-sm">
        {TYPE_LABEL[d.type] ?? d.type}
      </span>
      <span class:list={["rounded-full px-3 py-1 text-xs font-semibold shadow-sm", statusClass]}>
        {STATUS_LABEL[status]}
      </span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="text-sm font-medium text-brand">
      📅 {fmtDateShort(d.startDate)}
      {d.endDate ? ` – ${fmtDateShort(d.endDate)}` : ""}
    </div>
    <h3 class="mt-2 text-lg font-bold text-gray-900 group-hover:text-brand">
      {d.title}
    </h3>
    <p class="mt-2 line-clamp-3 flex-1 text-sm text-gray-600">{d.description}</p>
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
      <span>{modeIcon} {MODE_LABEL[d.mode] ?? d.mode}</span>
      {d.time && <span>🕐 {d.time}</span>}
      <span class="font-semibold text-gray-700">{d.price}</span>
    </div>
  </div>
</a>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>